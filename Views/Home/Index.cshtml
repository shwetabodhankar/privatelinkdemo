@model HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mb-5">
    <h1 class="display-4">@(Model.ApplicationTitle ?? "Sample Web Application")</h1>
    <p class="lead">@(Model.WelcomeMessage ?? "Welcome to the Sample Web Application")</p>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-key"></i> Azure Key Vault Configuration
                </h5>
            </div>
            <div class="card-body">
                <p class="card-text">This page displays configuration values retrieved from Azure Key Vault.</p>
                
                @if (Model.ConfigurationSettings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th><i class="bi bi-tag"></i> Setting Name</th>
                                    <th><i class="bi bi-info-circle"></i> Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var setting in Model.ConfigurationSettings)
                                {
                                    <tr>
                                        <td><strong>@setting.Key</strong></td>
                                        <td>
                                            @if (setting.Key.Contains("Key", StringComparison.OrdinalIgnoreCase) || 
                                                 setting.Key.Contains("Secret", StringComparison.OrdinalIgnoreCase) ||
                                                 setting.Key.Contains("Password", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-secondary">@setting.Value</span>
                                            }
                                            else
                                            {
                                                @setting.Value
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle"></i>
                        No configuration settings retrieved from Key Vault. Please ensure your Key Vault is configured correctly.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-shield-lock"></i> Secure Configuration</h5>
                <p class="card-text">
                    All sensitive configuration values are securely stored in Azure Key Vault and retrieved at runtime using managed identities.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-database"></i> Database Integration</h5>
                <p class="card-text">
                    Check out the <a asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-primary">
                        <i class="bi bi-bar-chart"></i> Dashboard
                    </a> to view data from Azure SQL Database.
                </p>
            </div>
        </div>
    </div>
</div>
